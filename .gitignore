# The repository is also the host (GitHub Pages): every tracked file is
# publicly downloadable, so only what the site serves is tracked.

# Hidden folders, except the ones the site or the host needs
.*/
!.github/
!.well-known/

# At the root: only the files of the site and of its tooling
/*.html
!/index.html
!/404.html
/*.css
/*.js
!/sw.js
!/eslint.config.js
/*.json
!/package.json
!/package-lock.json
!/.*.json
/*.md
!/README.md
/favicon_*.svg
!/favicon_1.svg

# Backups, scratch files and scripts
*backup*
*_base64.*
*.txt
!/robots.txt
!/.well-known/security.txt
*.ps1
*.py
*.cs
*.exe
*.zip

# Source material: only the optimised copies and the PDF sheets are served
dessin/*
!dessin/opt/
photo/*
!photo/opt/
fonts/*
!fonts/*.woff
!fonts/*.woff2

# Tooling
node_modules/
npm-debug.log*
.eslintcache

# System and editors
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
